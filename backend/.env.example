# Copy to .env and fill in. Every variable is validated at startup (src/config/env.js).

NODE_ENV=development
PORT=5000
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API (the admin panel).
CORS_ORIGINS=http://localhost:5173
# true when behind nginx
TRUST_PROXY=false

MONGO_URI=mongodb://127.0.0.1:27017/nearmart

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_DAYS=30

# Admin refresh cookie. Panel and API on different sites in production -> none + true.
COOKIE_SAMESITE=strict
COOKIE_SECURE=false

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_WINDOW=3
OTP_REQUEST_WINDOW_SECONDS=600
# Dev only: every OTP is DEFAULT_OTP_CODE. Rejected when NODE_ENV=production.
USE_DEFAULT_OTP=true
DEFAULT_OTP_CODE=123456

# console (dev: logs the code) | smsindiahub
SMS_PROVIDER=console
SMS_INDIA_HUB_API_KEY=
SMS_INDIA_HUB_SENDER_ID=
SMS_INDIA_HUB_USERNAME=
SMS_INDIA_HUB_DLT_TEMPLATE_ID=
# Must match the DLT-registered template exactly.
SMS_OTP_TEMPLATE=Your Nearmart OTP is {otp}. It is valid for 5 minutes.

RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=30

UPLOAD_STORAGE_ROOT=uploads
UPLOAD_BASE_URL=/uploads
UPLOAD_MAX_IMAGE_MB=5

# Push notifications are off unless one of these is set.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Online payments are off unless the key pair is set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
